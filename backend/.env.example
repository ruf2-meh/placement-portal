# Copy this file to .env and fill in real values. Never commit .env itself.

# Secret used to sign and verify JWTs (routes/auth.js and middleware/authMiddleware.js).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Optional: override the default server port (defaults to 5000)
# PORT=5000