# Fill in your MongoDB connection string below.
# Example: mongodb+srv://<user>:<pass>@cluster0.mongodb.net/placement_portal?retryWrites=true&w=majority
MONGO_URI=

# JWT secret for signing tokens (keep this secret in production)
JWT_SECRET=super_secret_placement_portal_key

# Optional: override default server port (defaults to 5000)
# PORT=5000
